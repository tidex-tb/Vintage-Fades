# Production environment for deploy/docker-compose.yml. Copy to deploy/.env and fill in.
# PLACEHOLDERS ONLY. Never commit the real file (.env is git-ignored).

# Public DNS name pointing at the server (Caddy issues the HTTPS certificate for it)
PUBLIC_HOSTNAME=bookings.example.com

# Database password (generate: openssl rand -base64 32)
POSTGRES_PASSWORD=change-me

# --- Meta app (developers.facebook.com > your app > App settings > Basic)
Meta__AppId=000000000000000
Meta__AppSecret=replace-with-app-secret
# Any long random string; enter the same value in each webhook configuration in the App Dashboard
Meta__WebhookVerifyToken=replace-with-long-random-string
Meta__ApiVersion=v26.0

# --- WhatsApp provider: YCloud = keep the existing WhatsApp Business app number (Coexistence through YCloud)
#                        Meta   = direct Meta Cloud API (needs the WhatsApp__PhoneNumberId/AccessToken below)
WhatsApp__Provider=YCloud
# YCloud console > Developers > API keys
YCloud__ApiKey=
# "secret" returned when the webhook endpoint https://<PUBLIC_HOSTNAME>/webhooks/ycloud is created
YCloud__WebhookSecret=
# The shop's existing WhatsApp Business number, E.164
YCloud__FromNumber=+264610000000
# Hours the bot stays quiet in a chat after the shop replies from the WhatsApp Business app
Chatbot__ManualReplyPauseMinutes=10

# --- WhatsApp direct Cloud API (only when WhatsApp__Provider=Meta)
WhatsApp__PhoneNumberId=
WhatsApp__BusinessAccountId=
WhatsApp__AccessToken=
# Owner's personal WhatsApp number in international format (NOT the shop number). Used by both providers.
WhatsApp__OwnerNotificationNumber=+264810000000
# Approved utility templates (see docs/META_SETUP.md). Empty = free-form text inside the 24h window only.
WhatsApp__OwnerNotificationTemplate__Name=
WhatsApp__OwnerNotificationTemplate__Language=en
WhatsApp__ReminderTemplate__Name=
WhatsApp__ReminderTemplate__Language=en

# --- Instagram Messaging (Instagram API with Instagram Login)
Instagram__AccountId=
Instagram__AccessToken=
# Instagram app secret (App Dashboard > Instagram > API setup with Instagram login). Empty = Meta__AppSecret.
Instagram__AppSecret=

# --- Facebook Messenger
Facebook__PageId=
Facebook__PageAccessToken=

# --- Scheduling
Booking__Reminder24HoursEnabled=true
Booking__Reminder2HoursEnabled=true

# --- Owner/operator API (generate: openssl rand -hex 32). Empty = admin API disabled.
Admin__ApiKey=
