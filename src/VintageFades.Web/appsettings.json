{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": { "IncludeScopes": false, "UseUtcTimestamp": true }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Hosting": {
    "UseForwardedHeaders": false,
    "UseHttpsRedirection": false
  },
  "Workers": {
    "Enabled": true
  },
  "Meta": {
    "AppId": "",
    "AppSecret": "",
    "WebhookVerifyToken": "",
    "ApiVersion": "v26.0",
    "GraphBaseUrl": "https://graph.facebook.com"
  },
  "WhatsApp": {
    "Provider": "Meta",
    "PhoneNumberId": "",
    "BusinessAccountId": "",
    "AccessToken": "",
    "OwnerNotificationNumber": "",
    "OwnerNotificationTemplate": { "Name": "", "Language": "en" },
    "ReminderTemplate": { "Name": "", "Language": "en" }
  },
  "YCloud": {
    "ApiKey": "",
    "WebhookSecret": "",
    "FromNumber": "",
    "BaseUrl": "https://api.ycloud.com/v2"
  },
  "Instagram": {
    "AccountId": "",
    "AccessToken": "",
    "AppSecret": "",
    "GraphBaseUrl": "https://graph.instagram.com"
  },
  "Facebook": {
    "PageId": "",
    "PageAccessToken": ""
  },
  "Booking": {
    "PendingHoldMinutes": 10,
    "MaxAlternatives": 5,
    "Reminder24HoursEnabled": true,
    "Reminder2HoursEnabled": true
  },
  "Chatbot": {
    "ConversationResetHours": 24,
    "ClarificationAttemptsBeforeHumanOffer": 2,
    "ManualReplyPauseMinutes": 10
  },
  "Outbox": {
    "MaxAttempts": 8,
    "BaseRetryDelaySeconds": 30,
    "MaxRetryDelayMinutes": 60
  },
  "Retention": {
    "ConversationMessageDays": 90,
    "WebhookEventDays": 30,
    "OutboxMessageDays": 90,
    "NotificationLogDays": 180
  },
  "Admin": {
    "ApiKey": ""
  }
}
