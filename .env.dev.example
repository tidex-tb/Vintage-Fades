# Settings for docker-compose.dev.yml (local development). Copy to .env.dev and fill in.
# .env.dev is git-ignored; never commit real values. appsettings.Example.json lists every other key
# (use __ instead of :, e.g. Meta__AppSecret). A channel with no credentials stays disabled.

# PostgreSQL container. Only read the first time the pgdata volume is created.
POSTGRES_DB=vintagefades
POSTGRES_USER=vintagefades
POSTGRES_PASSWORD=

# The app reaches the database by its service name, db.
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=vintagefades;Username=vintagefades;Password=;GSS Encryption Mode=Disable

# Owner dashboard (/dashboard/) password, at least 32 characters. Empty = dashboard and admin API disabled.
Admin__ApiKey=
